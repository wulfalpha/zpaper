#!/usr/bin/env python3
"""Optional fzf history picker. Usage: zpaper-pick [substring] [output]."""
import json
import subprocess
import sys


def main():
    if len(sys.argv) > 3:
        raise SystemExit('Usage: zpaper-pick [substring] [output]')
    pattern = sys.argv[1] if len(sys.argv) > 1 else ''
    entries = json.loads(subprocess.check_output(['zpaper', 'history', '--json']))
    entries = [entry for entry in entries if pattern in entry['path']]
    if not entries:
        raise SystemExit('No matching wallpaper history.')
    # Carry only a local index through the UI. Apply the selected path directly
    # so intervening daemon activity cannot change what a history index means.
    labels = [f"{i}\t{entry['path']}" for i, entry in enumerate(entries)]
    selected = subprocess.run(
        ['fzf', '--read0', '--print0', '--delimiter=\t', '--with-nth=2..',
         '--prompt=Wallpaper> '],
        input=('\0'.join(labels) + '\0').encode(), stdout=subprocess.PIPE)
    if selected.returncode:
        raise SystemExit(selected.returncode)
    index = int(selected.stdout.split(b'\t', 1)[0])
    command = ['zpaper', 'set']
    if len(sys.argv) == 3:
        command += ['--output', sys.argv[2]]
    command += ['--', entries[index]['path']]
    raise SystemExit(subprocess.run(command).returncode)


if __name__ == '__main__':
    try:
        main()
    except (FileNotFoundError, subprocess.CalledProcessError) as exc:
        raise SystemExit(f'zpaper-pick requires zpaper and fzf in PATH: {exc}')
