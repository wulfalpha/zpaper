# Copy to ~/.config/zpaper/zpaperc. Start explicitly with: zpaper daemon
# Bare zpaper runs once by default. Set daemon = true to keep it running.
# Explicit commands such as next always perform just that action.
daemon = false
dir = ~/wallstreet
recursive = true
interval = 30m

# Optional initial collection. A previously saved selection takes precedence.
# collection = quiet

# auto: Wayland uses awww if installed, otherwise swww; X11 uses feh.
# Choose awww or swww for monitor queries, targeting, and layout restoration.
backend = auto
backend_start = true

# While the daemon runs, put wallpapers back on monitors that are
# reconnected, newly plugged in, or blanked by a renderer restart. Outputs showing
# an image are left alone, so changes made outside zpaper are kept.
# With feh on X11 this watches `xrandr --listmonitors` and reruns feh on changes.
hotplug = true

# Supported by the built-in adapters: crop, fit, stretch, no.
resize = crop
# Backend-specific argv, parsed without invoking a shell.
# Wayland only with built-in adapters; custom setters also receive these args.
transition = --transition-type wave --transition-duration 2 --filter Lanczos3

# Maximum time for each backend invocation (1s–300s).
timeout = 15s
notify = false

# Optional command to run after each wallpaper change, e.g. to theme your desktop
# from the new image. %s is the image, %o the output ("*" with custom); if %s
# is absent the image is appended. Runs in the background without a shell; its
# output goes to ~/.local/state/zpaper/on_change.log.
# on_change = wal -q -i %s
# on_change = matugen image %s

# Optional fixed image; overrides directory rotation.
# wallpaper = ~/Pictures/favorite.jpg

# Custom setters have global-only, recorded-state semantics.
# Quotes and backslash escapes group arguments. Embedded %s is supported.
# If %s is absent, the image is appended. No shell evaluation takes place.
# A custom setter must exit after applying the wallpaper.
# backend = custom
# setter = hyprctl hyprpaper wallpaper ",%s"

# Named collections go after all global settings. Enable a section by uncommenting
# its header and dir. Interval and recursive inherit the globals when omitted.
# List with `zpaper collections`; select with `zpaper use quiet`.
# `zpaper use default` returns to the top-level dir/wallpaper configuration.
#
# [collection.quiet]
# dir = ~/Pictures/wallpapers/quiet
# interval = 45m
#
# [collection.landscapes]
# dir = ~/Pictures/wallpapers/landscapes
# interval = 20m
# recursive = false

# Optional per-monitor collections (awww/swww, or feh with xrandr). Sections for
# monitors that are not connected are ignored, so one file can name both a
# Wayland and an X11 monitor (often HDMI-A-1 vs HDMI-A-0). An assigned monitor always
# uses its collection and rotates on that collection's interval; other monitors
# follow the active collection. Find output names with `zpaper current`.
#
# [output.DP-2]
# collection = quiet

# Optional daily schedule, using the local timezone. Define the named collections
# above before enabling this example. The most recent entry remains active until
# the next one; a manual choice lasts until the next scheduled period.
# Holds still apply. Inspect with `zpaper schedule`; return early with
# `zpaper schedule resume`.
#
# [schedule]
# 08:00 = landscapes
# 20:00 = quiet
